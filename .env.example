# Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only privileged-account bootstrap. On the first deployment request,
# VanGO creates these two confirmed Auth users and assigns their real roles.
# Use different emails and strong passwords with at least 12 characters.
VANGO_SUPERADMIN_EMAIL=
VANGO_SUPERADMIN_PASSWORD=
VANGO_ADMIN_EMAIL=
VANGO_ADMIN_PASSWORD=

# Mock payment requires no financial-provider credentials and never charges money.
# Add a notification provider only when real email/SMS delivery is enabled.
NOTIFICATION_PROVIDER_SECRET=
